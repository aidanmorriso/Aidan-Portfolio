<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recipes - Aidan's Portfolio</title>
    <link rel="stylesheet" href="../css/style.css">
</head>
<body>
    <header>
        <nav>
            <a href="../index.html">Home</a>
            <a href="recipes.html">Recipes</a>
            <a href="../music.html">Music</a>
            <a href="../gallery.html">Gallery</a>
        </nav>
    </header>

    <main>
        <h1>Culinary Creations</h1>
        <p>Explore a curated collection of high-quality recipes from around the world.</p>
        
        <div id="recipes-container">
            <!-- Recipes will be loaded here by JavaScript -->
            <p>Loading recipes...</p>
        </div>
    </main>

    <script>
        fetch('../recipes/recipes.json')
            .then(response => response.json())
            .then(data => {
                const container = document.getElementById('recipes-container');
                container.innerHTML = '';
                
                const categories = [...new Set(data.map(item => item.category))];
                
                categories.forEach(category => {
                    const categorySection = document.createElement('section');
                    categorySection.className = 'recipe-category';
                    categorySection.innerHTML = `<h2>${category}</h2>`;
                    
                    const recipes = data.filter(item => item.category === category);
                    const grid = document.createElement('div');
                    grid.className = 'recipe-grid';
                    
                    recipes.forEach(recipe => {
                        const card = document.createElement('div');
                        card.className = 'recipe-card';
                        card.innerHTML = `
                            <h3>${recipe.title}</h3>
                            <p><strong>Ingredients:</strong> ${recipe.ingredients.join(', ')}</p>
                            <p><strong>Instructions:</strong> ${recipe.instructions}</p>
                        `;
                        grid.appendChild(card);
                    });
                    
                    categorySection.appendChild(grid);
                    container.appendChild(categorySection);
                });
            })
            .catch(error => {
                console.error('Error fetching recipes:', error);
                document.getElementById('recipes-container').innerHTML = '<p>Error loading recipes. Please try again later.</p>';
            });
    </script>
</body>
</html>
